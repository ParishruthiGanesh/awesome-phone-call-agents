# ---------------------------------------------------------------------------
# HerdRelay environment. Copy to .env and fill in. Never commit a real value.
# ---------------------------------------------------------------------------

# Call mode. `dry_run` is the default and is assumed whenever this is unset or
# unrecognised: no CALL-E request is made and no phone rings. Set to `live`
# only when you intend real outbound calls to a caretaker who has agreed to
# receive them.
HERDRELAY_MODE=dry_run

# Which scripted outcome the dry run should play back. One of:
# inspection_confirmed, followup_requested, declined, unanswered, voicemail,
# contradictory, provider_failure. Defaults to inspection_confirmed.
HERDRELAY_DRY_RUN_SCENARIO=inspection_confirmed

# ---------------------------------------------------------------------------
# Authorized caretaker. Required for live mode only.
# ---------------------------------------------------------------------------

# The one number HerdRelay may dial, in exact ASCII E.164 (leading +, country
# code, no spaces, no punctuation, no extension). The browser never sends a
# number; it is resolved here on the server so an approval can only ever
# authorize this destination. There is no hard-coded fallback: leave it empty
# and live calling stays refused.
HERDRELAY_AUTHORIZED_E164=

# Display name of the caretaker who has agreed, in advance, to receive
# AI-assisted monitoring calls at the number above.
HERDRELAY_CARETAKER_NAME=

# The farm or site named on the call, so the caretaker knows who is calling.
HERDRELAY_SITE_NAME=Ridgeline Dairy

# ---------------------------------------------------------------------------
# Self-service demo mode. Off unless this is exactly `true`.
# ---------------------------------------------------------------------------

# When on, the person using the console types the number to call and states
# that it is their own, instead of the destination coming from
# HERDRELAY_AUTHORIZED_E164. This is what makes a public demo able to call a
# judge's own phone -- and it is a more dangerous shape, so it is bounded by
# a consent statement, one call per number ever, a daily cap, a per-visitor
# attempt limit, a required sign-in, and erasure of the number after the call.
# Read the README's "Self-service demo mode" section before turning it on, and
# do not leave it running unattended.
HERDRELAY_SELF_SERVICE=false

# Most calls this deployment will place in one day, across everybody. Defaults
# to 5. An unusable value falls back to the default rather than to no cap.
HERDRELAY_DAILY_CALL_CAP=5

# Most attempts one visitor may make in an hour. Defaults to 3.
HERDRELAY_VISITOR_ATTEMPTS=3

# ---------------------------------------------------------------------------
# CALL-E credentials. Server-side only; never exposed to the browser.
# ---------------------------------------------------------------------------

# Credentials are sent only to https://api.heycall-e.com and redirects are
# refused. Required for live mode; ignored in dry run.
CALLE_API_KEY=

# Optional compatibility setting. Only https://api.heycall-e.com (with an
# optional trailing slash) is accepted.
CALLE_BASE_URL=

# ---------------------------------------------------------------------------
# Operator access
# ---------------------------------------------------------------------------

# Preferred: create named operator accounts instead, so an approval records the
# person who made it rather than the deployment:
#   npm run operators:add -- --username=marta --name="Marta Nowak"
#
# This is the fallback single shared login: username `herdrelay`, password this
# token, at least 32 random characters. Live mode needs one or the other. Dry
# run needs neither.
# Generate with: openssl rand -hex 32
HERDRELAY_AUTH_TOKEN=

# One account defined entirely here, as `username:Display Name:password`, for a
# deployed instance where nobody can open a shell to run `operators:add`
# (operators.json is gitignored and never travels with the code). Nothing is
# written to disk, so it works on a read-only filesystem.
#
# This password sits in the environment in plaintext, where a file account
# stores only a hash — so use it for a demonstration account whose password is
# published anyway, not for an operator whose approval means something.
#   HERDRELAY_OPERATOR_SEED=judge:Devpost Judge:your-password-here
HERDRELAY_OPERATOR_SEED=

# Where operator accounts are stored. Defaults to ./operators.json, which is
# gitignored and holds scrypt password hashes, never passwords.
HERDRELAY_OPERATORS_FILE=

# Exact browser origin, used for cross-origin rejection on state changes. Leave
# empty for local development: the request's own Host header is used instead, so
# any port works. Set it to your exact HTTPS origin when deploying behind a
# proxy or CDN.
HERDRELAY_ORIGIN=

# Where incident state is written. Defaults to ./data, which is gitignored.
HERDRELAY_DATA_DIR=
