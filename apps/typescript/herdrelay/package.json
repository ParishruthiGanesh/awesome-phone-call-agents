{
  "name": "herdrelay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Human-approved livestock incident coordination: turns a respiratory monitoring alert into one approved CALL-E call to an authorized caretaker.",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "operators:add": "node --env-file-if-exists=.env --import tsx scripts/operators.ts add",
    "operators:list": "node --env-file-if-exists=.env --import tsx scripts/operators.ts list",
    "demo:dry-run": "node --env-file-if-exists=.env --import tsx scripts/dry-run.ts",
    "call:preview": "node --env-file-if-exists=.env --import tsx scripts/preview-call.ts",
    "call:authorize": "node --env-file-if-exists=.env --import tsx scripts/preview-call.ts --authorize",
    "demo:reset": "node --import tsx scripts/reset-demo.ts"
  },
  "dependencies": {
    "@call-e/calle": "^0.7.0",
    "libphonenumber-js": "^1.13.12",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
